# === KlimaSun ortam değişkenleri ===
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# .env dosyası ASLA commit edilmez (bkz. .gitignore). Vercel'de bu değerleri
# Project Settings > Environment Variables altına girin.

# Google AI Studio'dan alınan Gemini API anahtarı (SADECE backend'de kullanılır).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# `npm run setup-store` komutunun çıktısı olarak verilen File Search Store adı.
# Örn: fileSearchStores/klimasun-dokumanlar-xxxxxxxx
GEMINI_FILE_SEARCH_STORE=

# Sitenin tam adresi (canonical URL, sitemap ve OpenGraph için).
NEXT_PUBLIC_SITE_URL=https://klimasun.vercel.app

# (Opsiyonel) Kalıcı soru-cevap deposu — Vercel KV / Upstash Redis (REST).
# Tanımlanmazsa uygulama yine çalışır; cevaplar her örnekte yeniden üretilir.
KV_REST_API_URL=
KV_REST_API_TOKEN=
