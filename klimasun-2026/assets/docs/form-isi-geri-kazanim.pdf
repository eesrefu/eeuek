                        <style>
            #fm-popup-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.6);
                z-index: 99999;
                align-items: center;
                justify-content: center;
                padding: 20px;
                backdrop-filter: blur(3px);
            }
            #fm-popup-overlay.show { display: flex; }

            #fm-popup-box {
                background: #fff;
                border-radius: 16px;
                overflow: hidden;
                position: relative;
                width: 100%;
                max-width: 640px;
                max-height: 92vh;
                overflow-y: auto;
                box-shadow: 0 25px 70px rgba(0,0,0,0.35);
                animation: fmPopIn 0.38s cubic-bezier(0.175,0.885,0.32,1.275) forwards;
            }
            @keyframes fmPopIn {
                from { opacity: 0; transform: scale(0.82) translateY(28px); }
                to   { opacity: 1; transform: scale(1) translateY(0); }
            }

            /* ── Kapatma butonu ── */
            #fm-popup-close {
                position: absolute;
                top: 11px; right: 13px;
                background: rgba(0,0,0,0.18);
                border: none;
                color: #fff;
                width: 30px; height: 30px;
                border-radius: 50%;
                font-size: 16px;
                cursor: pointer;
                z-index: 20;
                display: flex; align-items: center; justify-content: center;
                transition: background .2s;
            }
            #fm-popup-close:hover { background: rgba(0,0,0,0.4); }

            /* ── YATAY (landscape) — görsel üstte tam genişlik ── */
            .fm-layout-landscape .fm-popup-img-wrap { width: 100%; }
            .fm-layout-landscape .fm-popup-img {
                width: 100%;
                aspect-ratio: 16/9;
                object-fit: cover;
                display: block;
            }
            .fm-layout-landscape .fm-popup-body { padding: 26px 30px; }

            /* ── KARE (square) — görsel üstte kare ── */
            .fm-layout-square .fm-popup-img-wrap { width: 100%; }
            .fm-layout-square .fm-popup-img {
                width: 100%;
                aspect-ratio: 1/1;
                object-fit: cover;
                display: block;
            }
            .fm-layout-square .fm-popup-body { padding: 24px 28px; }

            /* ── DİKEY (portrait) — görsel solda ── */
            .fm-layout-portrait { display: flex; align-items: stretch; }
            .fm-layout-portrait .fm-popup-img-wrap {
                flex: 0 0 42%;
                max-width: 42%;
            }
            .fm-layout-portrait .fm-popup-img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }
            .fm-layout-portrait .fm-popup-body {
                flex: 1;
                padding: 30px 26px;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }
            @media (max-width: 540px) {
                .fm-layout-portrait { flex-direction: column; }
                .fm-layout-portrait .fm-popup-img-wrap { flex: none; max-width: 100%; }
                .fm-layout-portrait .fm-popup-img { aspect-ratio: 16/9; height: auto; }
            }

            /* ── İçerik ── */
            .fm-popup-title {
                font-size: 20px; font-weight: 700;
                color: #1a1a2e; line-height: 1.3;
                margin-bottom: 10px;
            }
            .fm-popup-content {
                font-size: 14px; color: #555;
                line-height: 1.7; margin-bottom: 18px;
            }
            .fm-popup-btn {
                display: inline-block;
                padding: 11px 26px;
                border-radius: 8px;
                color: #fff !important;
                font-weight: 600;
                font-size: 14px;
                text-decoration: none;
                transition: opacity .2s, transform .2s;
            }
            .fm-popup-btn:hover { opacity: .85; transform: translateY(-1px); }
        </style>

        <div id="fm-popup-overlay"  onclick="if(event.target===this)closeFmPopup()" >
            <div id="fm-popup-box" class="fm-layout-square">

                                <button id="fm-popup-close" onclick="closeFmPopup()" title="Kapat">✕</button>
                
                                <div class="fm-popup-img-wrap">
                                        
                    <a href="https://formmerkeziklima.com/tr/ucretsiz-kesif-formu" title="" style="display:block;line-height:0;">
                        <img src="https://formmerkeziklima.com/upload/popup/1867418603216725.png" alt="" class="fm-popup-img" style="cursor:pointer;">
                    </a>
                                    </div>
                
                
                
            </div>
        </div>

        <script>
        (function() {
            var cookieName = 'fm_popup_1';
            var cookieDays = 1;
            var delay      = 2000;

            function getCookie(name) {
                var v = document.cookie.match('(^|;) ?' + name + '=([^;]*)(;|$)');
                return v ? v[2] : null;
            }
            function setCookie(name, days) {
                var d = new Date();
                d.setTime(d.getTime() + 24*60*60*1000*days);
                document.cookie = name + '=1;expires=' + d.toGMTString() + ';path=/';
            }
            if (!cookieDays || !getCookie(cookieName)) {
                setTimeout(function() {
                    document.getElementById('fm-popup-overlay').classList.add('show');
                }, delay);
            }
            window.closeFmPopup = function() {
                document.getElementById('fm-popup-overlay').classList.remove('show');
                if (cookieDays > 0) setCookie(cookieName, cookieDays);
            };
        })();
        </script>
        
            <script>
       
            document.addEventListener('DOMContentLoaded', function () {
                document.querySelectorAll('.lazyload').forEach((el) => {
                    const bg = el.getAttribute('data-bg');
                    if (bg) el.style.backgroundImage = bg;
                });
        });
    </script>
    </body>
</html>